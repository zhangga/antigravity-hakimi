{
  "name": "antigravity-hakimi",
  "version": "1.0.0",
  "description": "macOS Apple Silicon (ARM64) standalone 哈基米.app patcher with region unlock, context & token viewer, and UI localization",
  "engines": {
    "node": ">=22.4.0"
  },
  "scripts": {
    "build:renderer": "node scripts/build-renderer.js",
    "pretest": "node scripts/build-renderer.js",
    "test": "node --test test/*.test.js",
    "build:hakimi": "bash ./build-hakimi.sh",
    "build:win": "node scripts/build-renderer.js && node scripts/build-hakimi-win.js",
    "build:win:stage": "node scripts/build-renderer.js && node scripts/build-hakimi-win.js --stage-only",
    "set-icon": "bash ./set-hakimi-icon.sh",
    "unlock:cli": "node scripts/cli-unlock.js --apply",
    "accounts": "node scripts/account-switch.js",
    "doctor": "node scripts/doctor.js"
  },
  "keywords": [
    "antigravity",
    "hakimi",
    "macos",
    "arm64",
    "context-viewer",
    "context-window",
    "token-tracker",
    "region-unlock"
  ],
  "license": "MIT"
}
